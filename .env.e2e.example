# Copy to .env.e2e. Never copy production credentials here.
# local starts a fresh frontend; staging expects separately managed servers.
# production is recognized but always BLOCKED in Phase 1.
E2E_TARGET=local

# Origins only; E2E_API_URL must NOT include /api.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000

# Local-only baseline seeded by the backend e2e:reset command.
# Keep these values aligned with the backend .env.e2e.
E2E_ADMIN_EMAIL=e2e.admin@example.test
E2E_ADMIN_PASSWORD=E2E-Admin-2026!
E2E_ALUMNI_EMAIL=e2e.alumni@example.test
E2E_ALUMNI_PASSWORD=E2E-Alumni-2026!
