# ==========================================
# Frontend Environment Configuration Template
# Salin file ini menjadi `.env.local` untuk development lokal
# atau `.env.production` saat deploy ke server produksi.
# ==========================================

# Base URL API Laravel Backend (dengan suffix /api)
# Development: http://127.0.0.1:8000/api atau http://localhost:8000/api
# Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Backend Server Host (digunakan oleh Next.js standalone rewrite proxy)
# Development: http://127.0.0.1:8000
# Production: https://api.yourdomain.com
BACKEND_URL=http://127.0.0.1:8000

# Google OAuth Client ID (Opsional jika login Google diarahkan via backend redirect)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
